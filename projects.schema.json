{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Public product discovery archive",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "language",
    "updatedAt",
    "count",
    "projects"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "language": {
      "type": "string",
      "minLength": 1
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "provider": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "sourceId": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https?://"
          },
          "canonicalUrl": {
            "type": "string",
            "format": "uri",
            "pattern": "^https?://"
          },
          "sourceUrl": {
            "type": "string",
            "format": "uri",
            "pattern": "^https?://"
          },
          "hnUrl": {
            "anyOf": [
              {
                "type": "string",
                "format": "uri",
                "pattern": "^https?://"
              },
              {
                "type": "null"
              }
            ]
          },
          "publishedAt": {
            "type": "string",
            "format": "date-time"
          },
          "discoveredAt": {
            "type": "string",
            "format": "date-time"
          },
          "audience": {
            "type": "string",
            "minLength": 1
          },
          "what": {
            "type": "string",
            "minLength": 1
          },
          "why": {
            "type": "string",
            "minLength": 1
          },
          "whySource": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "urls"
            ],
            "properties": {
              "status": {
                "enum": [
                  "author_stated",
                  "official_stated",
                  "product_goal_only",
                  "not_stated"
                ]
              },
              "urls": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https?://"
                }
              }
            }
          },
          "verification": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "summary",
              "checkedAt"
            ],
            "properties": {
              "status": {
                "enum": [
                  "interactive_demo",
                  "page_reviewed",
                  "source_reviewed",
                  "limited"
                ]
              },
              "summary": {
                "type": "string",
                "minLength": 1
              },
              "checkedAt": {
                "type": "string",
                "format": "date-time"
              }
            }
          },
          "caveats": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "url"
              ],
              "properties": {
                "type": {
                  "enum": [
                    "discussion",
                    "source_metadata",
                    "repository",
                    "official_site"
                  ]
                },
                "url": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https?://"
                }
              }
            }
          },
          "tags": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id",
          "provider",
          "source",
          "sourceId",
          "title",
          "url",
          "canonicalUrl",
          "sourceUrl",
          "hnUrl",
          "publishedAt",
          "discoveredAt",
          "audience",
          "what",
          "why",
          "whySource",
          "verification",
          "caveats",
          "sources"
        ]
      }
    }
  }
}
